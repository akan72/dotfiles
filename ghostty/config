window-padding-x = 2
window-padding-y = 0
# Resize regular macOS windows in whole cells to minimize unused bottom space.
window-step-resize = true
# Show the standard macOS title bar and window controls.
macos-titlebar-style = native
# Size regular windows in cells; fullscreen may leave partial-row padding.
window-width = 120
window-height = 32
# Do not restore pixel-sized window frames that bypass the initial grid fit.
window-save-state = never
# Preserve Powerline edges; do not use extend-always, which causes color bleed.
# Accept neutral sub-cell padding when fullscreen cannot fit an exact row grid.
window-padding-color = extend
theme = Gruvbox Material
term = xterm-256color
auto-update = off
copy-on-select = clipboard
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor
font-family = Hack Nerd Font Mono Bold
# Keep new windows at the same readable size as the verified terminal.
font-size = 18

# Send newline to Claude Code using shift + enter
keybind = shift+enter=text:\n

# Enable desktop notifications
desktop-notifications = true

# Turn off ligatures
font-feature = -calt, -liga, -dlig
