{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(ls *)",
      "Bash(xargs *)",
      "Bash(git mv *)",
      "Bash(for chain in axelar boba corn monad nova memecore ronin multiversx linea algorand helium hivemapper hedera near jupiter walrus momentum flare metis iotex manta ink soneium astar janus_henderson moonbeam berachain unichain worldchain sonic abstract bob b3 mode apechain plume story codex hyperevm ripple movement katana conflux decentraland core plasma tempo_andantino provenance tezos)",
      "Bash(if [ -d \"/Users/alexkan/work/gokustats-back-end/artemis_dagster/extract_load/primary_sources/$chain\" ])",
      "Bash(then)",
      "Bash(echo *)",
      "Bash(for chain in axelar memecore ronin multiversx linea algorand helium hivemapper hedera near jupiter walrus momentum flare metis iotex manta ink soneium astar moonbeam berachain unichain worldchain sonic abstract bob b3 mode apechain plume story codex hyperevm ripple conflux core provenance)",
      "Bash(gh pr list *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(pwd *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(diff *)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(curl *)",
      "Bash(lsof *)",
      "Bash(test *)",
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Skill(session-handoff)",
      "Skill(session-handoff:*)",
      "Skill(context-resume)",
      "Skill(context-resume:*)",
      "Skill(tech-debt)",
      "Skill(tech-debt:*)",
      "Skill(security-audit)",
      "Skill(security-audit:*)",
      "Skill(product-enhance)",
      "Skill(product-enhance:*)",
      "Skill(docs-review)",
      "Skill(docs-review:*)",
      "Skill(frontend-performance-audit)",
      "Skill(frontend-performance-audit:*)",
      "Edit(/tmp/**)",
      "Edit(~/.claude/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "outputStyle": "Concise",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          },
          {
            "type": "command",
            "command": "INFO=$(tmux display-message -p 'Window #I, Pane #P' 2>/dev/null || echo '?'); osascript -e \"display notification \\\"Claude is ready! ($INFO)\\\" with title \\\"Claude Code\\\"\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pretooluse-permissions.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-wiggum@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "planetscale@planetscale": true,
    "artemis-skills@artemis-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "planetscale": {
      "source": {
        "source": "github",
        "repo": "planetscale/claude-plugin"
      }
    },
    "artemis-skills": {
      "source": {
        "source": "github",
        "repo": "Artemis-xyz/artemis-skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": []
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "teammateMode": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
