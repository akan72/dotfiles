	name = Alex Kan
	username = akan72
	# signingkey intentionally unset — resolved at sign time by
	# gpg.ssh.defaultKeyCommand below, which pulls the first key from ssh-agent.
	# Whichever key it picks must be uploaded to GitHub as a *signing* key
	# (Settings > SSH and GPG keys > New SSH key > type "Signing").

[gpg]
	# Sign with SSH keys rather than GPG — reuses the SSH key already used for
	# auth, so there is no separate GPG keyring to manage (works the same on a
	# remote box, e.g. EC2, as long as the key is present or agent-forwarded).
	format = ssh

[gpg "ssh"]
	# Portable across machines: read the first key from whichever ssh-agent
	# is currently exposed (macOS system agent, 1Password, gpg-agent, etc.)
	# rather than hardcoding ~/.ssh/id_ed25519.pub. Works with hardware-
	# resident keys (YubiKey ed25519-sk, 1Password) where there may be no
	# .pub file on disk. The `key::` prefix is what git's source explicitly
	# looks for in defaultKeyCommand output.
	#
	# Deliberately free of double quotes: git's config parser consumes `"` and
	# expands `\n` in values, so a shell-quoted `"$(...)"` written here reaches
	# sh UNQUOTED. That mattered — `ssh-add -L` prints "The agent has no
	# identities." on *stdout* (not stderr) with an empty agent, and word
	# splitting then ran `The` as a command. The grep filter keeps only real
	# key lines, so an empty agent yields empty output and git fails cleanly
	# with "user.signingKey needs to be set" instead of signing garbage.
	defaultKeyCommand = sh -c 'ssh-add -L 2>/dev/null | grep -m1 -e ^ssh- -e ^sk- -e ^ecdsa- | sed -e s/^/key::/'

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[core]
	editor = nvim
    pager = delta

[delta]
    # use n and N to move between diff sections
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true

[diff]
    colorMoved = default

[interactive]
    diffFilter = delta --color-only

[add.interactive]
    useBuiltin = false # required for git 2.37.0

[merge]
    conflictstyle = diff3

[pager]
	branch = cat

[web]
	browser = google-chrome

[push]
	autoSetupRemote = true

[pull]
    rebase = false

[include]
	# Machine-local overrides (credential helper, signing key). Kept out of the
	# repo so per-host secrets/paths never propagate to other machines. Git
	# silently ignores this if the file is absent, so it is safe to share.
	path = ~/.gitconfig.local
